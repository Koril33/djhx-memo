[Unit]
Description=djhx-memo consistent encrypted daily backup
After=djhx-memo.service

[Service]
Type=oneshot
User=djhx-memo
Group=djhx-memo
UMask=0077
ExecStart=/usr/local/libexec/djhx-memo-backup
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/djhx-memo/db /var/lib/djhx-memo/backups /var/lib/djhx-memo-export
ReadOnlyPaths=/var/lib/djhx-memo/runtime /etc/djhx-memo-backup
